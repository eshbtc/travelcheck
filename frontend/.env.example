# =============================================================================
# DATABASE CONFIGURATION (Railway PostgreSQL)
# =============================================================================
# Railway will automatically provide this via their PostgreSQL plugin
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@hostname:5432/database

# =============================================================================
# NEXTAUTH CONFIGURATION
# =============================================================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-generate-with-openssl

# Production URL (update with your Railway domain)
NEXTAUTH_URL=https://your-app.railway.app

# =============================================================================
# OAUTH PROVIDERS
# =============================================================================
# Google OAuth (for Google login and Gmail integration)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Azure AD / Microsoft 365 OAuth
AZURE_AD_CLIENT_ID=your-azure-client-id
AZURE_AD_CLIENT_SECRET=your-azure-client-secret
AZURE_AD_TENANT_ID=your-azure-tenant-id

# =============================================================================
# EMAIL INTEGRATION (Gmail API)
# =============================================================================
GMAIL_CLIENT_ID=your-gmail-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REDIRECT_URI=https://your-app.railway.app/auth/callback?provider=gmail

# Office 365 / Outlook Integration
OFFICE365_CLIENT_ID=your-office365-client-id
OFFICE365_CLIENT_SECRET=your-office365-client-secret
OFFICE365_REDIRECT_URI=https://your-app.railway.app/auth/callback?provider=office365

# =============================================================================
# MINIO STORAGE (Railway S3-compatible storage for passport images and documents)
# =============================================================================
# Railway automatically provides these variables when you add Minio service:
# - MINIO_ROOT_USER (maps to S3_ACCESS_KEY_ID)
# - MINIO_ROOT_PASSWORD (maps to S3_SECRET_ACCESS_KEY)
# - MINIO_HOST
# - MINIO_PORT

# S3-compatible storage configuration
S3_ENDPOINT=http://${MINIO_HOST}:${MINIO_PORT}
S3_ACCESS_KEY_ID=${MINIO_ROOT_USER}
S3_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
S3_BUCKET_NAME=travel-check-uploads
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Public URL for serving images (Railway provides this)
S3_PUBLIC_URL=https://your-minio-service.up.railway.app

# Alternative: Cloudflare R2 (if you prefer R2 over Minio)
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET_NAME=travel-check-uploads
# R2_PUBLIC_URL=https://your-bucket.r2.dev

# =============================================================================
# GOOGLE CLOUD AI SERVICES
# =============================================================================
# Google AI API (Gemini) for passport analysis
GOOGLE_AI_API_KEY=your-google-ai-api-key

# Document AI (optional, for advanced OCR)
GOOGLE_CLOUD_DOCUMENT_AI_PROCESSOR_ID=your-processor-id
GOOGLE_CLOUD_DOCUMENT_AI_PASSPORT_PROCESSOR_ID=your-passport-processor-id

# Vertex AI configuration (if using GCP service account)
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
NEXT_PUBLIC_APP_NAME=TravelCheck
NEXT_PUBLIC_APP_URL=https://your-app.railway.app

# Admin users (comma-separated emails)
NEXT_PUBLIC_ADMIN_EMAILS=admin@yourdomain.com
ADMIN_EMAILS=admin@yourdomain.com

# Environment
NODE_ENV=production

# =============================================================================
# CRON & BACKGROUND JOBS
# =============================================================================
# Secret token for authenticating CRON requests
CRON_SECRET=your-random-cron-secret-token

# =============================================================================
# OPTIONAL: MONITORING & OBSERVABILITY
# =============================================================================
# Sentry (error tracking)
# SENTRY_DSN=your-sentry-dsn
# NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn

# PostHog (analytics)
# NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# =============================================================================
# RATE LIMITING & SECURITY
# =============================================================================
# Rate limit configuration (requests per minute)
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=https://your-app.railway.app,https://www.yourdomain.com

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable/disable features
NEXT_PUBLIC_ENABLE_AI_SUGGESTIONS=true
NEXT_PUBLIC_ENABLE_DUPLICATE_DETECTION=true
NEXT_PUBLIC_ENABLE_BATCH_PROCESSING=true
NEXT_PUBLIC_ENABLE_EMAIL_INTEGRATION=true

# =============================================================================
# DEVELOPMENT ONLY (remove in production)
# =============================================================================
# Skip email verification in development
# SKIP_EMAIL_VERIFICATION=true

# Enable debug logging
# DEBUG=true
# NEXT_PUBLIC_DEBUG=true
